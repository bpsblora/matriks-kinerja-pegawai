# Firebase Web SDK: client-side project identifiers (NOT service account keys).
# Set per environment when frontend is migrated from the v2.6 prototype.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Never put Firebase Admin service account JSON or OAuth client secrets here.
