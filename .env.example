# Konfigurasi WEB APP Firebase DEV — dapat disertakan di kode klien.
# Firebase Web API key BUKAN secret admin. Lindungi API key lewat pembatasan API
# dan Firestore lewat Security Rules + App Check.
# Nilai ini hanya berlaku untuk proyek DEV mkp-bps-blora.
VITE_FIREBASE_API_KEY=AIzaSyBI8uilA9W9WkYhGuCfC6r3JLTBeyu2WQM
VITE_FIREBASE_AUTH_DOMAIN=mkp-bps-blora.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mkp-bps-blora
VITE_FIREBASE_STORAGE_BUCKET=mkp-bps-blora.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=154312194111
VITE_FIREBASE_APP_ID=1:154312194111:web:e5c5512c09e0436601608a

# JANGAN tambahkan service account JSON/private key/OAuth client secret.
# Jangan unggah data pegawai asli sampai izin TI dan Security Rules selesai.

# DEV username/password auth is deliberately DISABLED until backend, tests and
# project billing/security have been reviewed and approved.
# Two-step login: a configured, dedicated Google VIEWER account may see
# approved read-only collections once Security Rules are tested.
# Its UID is NOT a secret, but must be set deliberately after TI approval.
# Do not share the Firebase owner's Google account password.
VITE_VIEWER_GOOGLE_UID=AYyTDvPFAWdyjD9WRADKwIRP4in2
VITE_ROLE_AUTH_READY=false
VITE_FIREBASE_FUNCTION_REGION=us-central1
