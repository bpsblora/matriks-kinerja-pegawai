rules_version = '2';

// PROPOSAL FOR AUTH TEST ONLY. NOT DEPLOYED BY firebase.json.
// Existing firestore.rules remains deny-all.
// Before publishing: test in Emulator, provision one demo user via Admin Console,
// and review with TI. This is not a complete role model for Matriks v2.6.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // A user can read only their own approved profile.
      // Other users, listing, and ALL client writes remain blocked.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
